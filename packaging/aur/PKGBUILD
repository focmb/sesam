# Maintainer: Christian Leitzke <christian.leitzke@gmail.com>
pkgname=sesam
pkgver=1.7.2
pkgrel=1
pkgdesc="SSH-Verbindungen verwalten und in frei konfigurierbaren Terminals öffnen"
arch=('any')
url="https://github.com/focmb/sesam"
license=('MIT')
depends=('python' 'pyside6' 'python-keyring' 'python-cryptography'
         'python-paramiko' 'openssh' 'hicolor-icon-theme')
makedepends=('python-build' 'python-installer' 'python-setuptools' 'python-wheel')
optdepends=('wireguard-tools: Endpunkt und Handshake in der WireGuard-Anzeige'
            'gnome-keyring: Passwörter im Schlüsselbund speichern'
            'kwallet: Passwörter im Schlüsselbund speichern')
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('acaa5ff13a62499a71b2bb3d49980fa420a75736feac688affd377799b274fd9')

build() {
  cd "$srcdir/$pkgname-$pkgver"
  python -m build --wheel --no-isolation
}

package() {
  cd "$srcdir/$pkgname-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl

  install -Dm644 packaging/linux/sesam.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/sesam.svg"

  # Platzhalter @EXEC@ im Starter durch den Befehl ersetzen
  sed 's|"@EXEC@"|sesam|' packaging/linux/sesam.desktop > "$srcdir/sesam.desktop"
  install -Dm644 "$srcdir/sesam.desktop" "$pkgdir/usr/share/applications/sesam.desktop"

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
